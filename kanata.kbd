;; ================================================================================
;; KANATA KEYBOARD CONFIGURATION
;; ================================================================================
;; This configuration implements home row modifiers (HRM) with intelligent timing
;; to distinguish between normal typing and modifier key activation.
;;
;; KEY FEATURES:
;; - Home row keys (a,s,d,f,j,k,l,;) act as modifiers when held
;; - Space bar toggles function layer for arrow keys and special functions
;; - Smart timing prevents accidental modifier activation during fast typing
;; ================================================================================

;; ================================================================================
;; GLOBAL CONFIGURATION SETTINGS
;; ================================================================================
(defcfg
  ;; Allow keys not explicitly defined in layers to pass through normally
  ;; This means you don't have to map every single key - unmapped keys work as usual
  process-unmapped-keys yes

  ;; Only remap the W-CORNE (USB id 55D4:0461). Every other keyboard is left
  ;; alone and reaches Windows untouched. That matters for Remote Desktop into
  ;; this PC: the keyboard of the connecting computer shows up here as one more
  ;; keyboard device, Kanata used to grab it and send its output to the
  ;; physical keyboard stack, which a remote session does not listen to, so
  ;; nothing could be typed over RDP (2026-11-19). Only the Interception build
  ;; reads this option; the hook build ignores it.
  ;; The value is the hardware id as bytes (UTF-16), as Kanata prints it:
  ;;   HID\VID_55D4&PID_0461&REV_0100&MI_00, HID\VID_55D4&PID_0461&MI_00, ...
  ;; To read it again, add windows-interception-keyboard-hwids-exclude ("1, 2")
  ;; to a copy of this file, run kanata_wintercept.exe --debug with it and
  ;; look for "is intercepted" in the output after pressing a key.
  windows-interception-keyboard-hwids (
    "72, 0, 73, 0, 68, 0, 92, 0, 86, 0, 73, 0, 68, 0, 95, 0, 53, 0, 53, 0, 68, 0, 52, 0, 38, 0, 80, 0, 73, 0, 68, 0, 95, 0, 48, 0, 52, 0, 54, 0, 49, 0, 38, 0, 82, 0, 69, 0, 86, 0, 95, 0, 48, 0, 49, 0, 48, 0, 48, 0, 38, 0, 77, 0, 73, 0, 95, 0, 48, 0, 48, 0, 0, 0, 72, 0, 73, 0, 68, 0, 92, 0, 86, 0, 73, 0, 68, 0, 95, 0, 53, 0, 53, 0, 68, 0, 52, 0, 38, 0, 80, 0, 73, 0, 68, 0, 95, 0, 48, 0, 52, 0, 54, 0, 49, 0, 38, 0, 77, 0, 73, 0, 95, 0, 48, 0, 48, 0, 0, 0, 72, 0, 73, 0, 68, 0, 92, 0, 86, 0, 73, 0, 68, 0, 95, 0, 53, 0, 53, 0, 68, 0, 52, 0, 38, 0, 85, 0, 80, 0, 58, 0, 48, 0, 48, 0, 48, 0, 49, 0, 95, 0, 85, 0, 58, 0, 48, 0, 48, 0, 48, 0, 54, 0, 0, 0, 72, 0, 73, 0, 68, 0, 95, 0, 68, 0, 69, 0, 86, 0, 73, 0, 67, 0, 69, 0, 95, 0, 83, 0, 89, 0, 83, 0, 84, 0, 69, 0, 77, 0, 95, 0, 75, 0, 69, 0, 89, 0, 66, 0, 79, 0, 65, 0, 82, 0, 68, 0, 0, 0, 72, 0, 73, 0, 68, 0, 95, 0, 68, 0, 69, 0, 86, 0, 73, 0, 67, 0, 69, 0, 95, 0, 85, 0, 80, 0, 58, 0, 48, 0, 48, 0, 48, 0, 49, 0, 95, 0, 85, 0, 58, 0, 48, 0, 48, 0, 48, 0, 54, 0, 0, 0, 72, 0, 73, 0, 68, 0, 95, 0, 68, 0, 69, 0, 86, 0, 73, 0, 67, 0, 69"
  )
  
  ;; OPTIONAL SETTINGS (currently disabled):
  ;; tap-next-release yes  ;; Would enable tap behavior on next key release
  ;; log-layer-changes yes ;; Would log layer changes for debugging
)

;; ================================================================================
;; SOURCE KEYBOARD LAYOUT DEFINITION
;; ================================================================================
;; This section defines which physical keys we're remapping.
;; Only keys listed here can be remapped in the layers below.
;; Keys are arranged to match their physical position on the keyboard.
(defsrc
  1    2    3    4    5    6    7    8    9    0
  q    w    e    r    t    y    n    [    ]
  caps a    s    d    f    i    j    k    l    ;    '
  u    o    p    m    /
  spc  f13  f14  f16  f17
  ;; h is listed only so the fn layer can put PageUp on it
  h
  ;; The W-CORNE's symbol row on its layer 1 (middle thumb held, bottom row):
  ;; F18 to F24 stand for ! @ # $ % ^ &. See the base layer for why.
  f18  f19  f20  f21  f22  f23  f24
)

;; ================================================================================
;; TIMING VARIABLES FOR HOME ROW MODIFIERS
;; ================================================================================
;; These timing values control how the keyboard distinguishes between:
;; - TAPPING a key (for normal character input)
;; - HOLDING a key (to activate it as a modifier)
;; All values are in milliseconds (ms)
(defvar
  ;; Maximum time a key can be held to still count as a "tap" (character input)
  ;; If released within 50ms → always outputs the character
  tap-time 50
  
  ;; Minimum time a key must be held to activate as a modifier
  ;; Hold for 200ms+ → activates the modifier function
  hold-time 200
  
  ;; Time window for detecting "fast typing" patterns
  ;; If 3 keys are pressed within 150ms → system assumes you're typing normally
  ;; This prevents modifiers from activating during rapid typing
  key-timing-delay 150
  
  ;; Maximum time to wait before deciding between tap vs hold
  ;; After 150ms, if key is still pressed → starts transitioning to hold mode
  tap-timeout 150
  
  ;; Time required to definitively activate hold mode (modifier)
  ;; After 200ms of holding → modifier is active
  hold-timeout 200
  
  ;; Eager tap behavior (currently unused but available)
  ;; Would release modifier immediately when another key is pressed
  eager-tap-timeout 120

  ;; True when the key Kanata sent last was a modifier, that is, when the
  ;; previous home row key was decided as a hold. Used by charmod and
  ;; a-special to tell stacking modifiers (J, then ; for Ctrl+Win) from a
  ;; fast roll over the home row inside a word ("asdf").
  after-mod (or (key-history lmet 1) (key-history lalt 1) (key-history lsft 1) (key-history lctl 1)
                (key-history rmet 1) (key-history ralt 1) (key-history rsft 1) (key-history rctl 1))

  ;; SAME-HAND KEY LISTS FOR THE HOME ROW MODIFIERS
  ;; A home row key held together with a key of the SAME hand is almost
  ;; always just typing (a roll), so those keys force the tap. Only a key of
  ;; the other hand, or a thumb, can make the home row key a modifier early.
  ;; This is what hold-trigger-key-positions does in the ZMK Corne config.
  ;; The home row keys themselves are NOT in the lists. Two modifiers of the
  ;; same hand have to stack, for example J + ; + A for Ctrl+Win+A (the Deskbar
  ;; workspace switch). With j k l ; in right-keys, pressing ; after J made J
  ;; a plain "j" and the shortcut typed "j;a". The ZMK config gets the same
  ;; effect with hold-trigger-on-release.
  left-keys  (q w e r t g z x c v b)
  right-keys (y u i o p h n m , . / ')
)

;; ================================================================================
;; SMART HOME ROW MODIFIER TEMPLATE
;; ================================================================================
;; This template creates intelligent home row modifiers that can distinguish
;; between normal typing and intentional modifier use.
;;
;; HOW IT WORKS:
;; 1. When you press a home row key, it first checks your typing speed
;; 2. If you're typing fast (3 keys within 150ms) → outputs the character
;; 3. If you're typing slowly or holding → uses tap-hold logic:
;;    - Quick tap (< 150ms) → outputs character
;;    - Hold (> 200ms) → activates modifier
;;
;; PARAMETERS:
;; - char: The character to output when tapped (e.g., 's' for the S key)
;; - mod: The modifier to activate when held (e.g., lalt for Left Alt)
(deftemplate charmod (char mod tapkeys held)
  (switch 
    ;; FAST TYPING CHECK: Have 3 keys been pressed within key-timing-delay (150ms)?
    ;; This detects rapid typing patterns where modifiers shouldn't activate
    ;; Recency 1 = the most recent key pressed before this one (per the Kanata
    ;; docs). So: if the previous key went down less than key-timing-delay
    ;; ago, this is mid-word typing and the key is a plain character at once.
    ;; Same idea as require-prior-idle-ms = 150 in the ZMK Corne config.
    ;; It was "3 keys within 150ms" before, which is so fast it rarely applied:
    ;; "worked" came out as "worED" because K, held a touch long over E and D,
    ;; became Shift.
    ;; The guard is skipped while another home row key is physically held
    ;; ($held). That is someone stacking modifiers, for example J then ; then
    ;; A for Ctrl+Win+A, not someone typing a word. Without this the second
    ;; modifier came within 150ms of the first and was typed as a letter,
    ;; so the chord only worked when done very slowly.
    ;; But only when the key before this one came out as a modifier
    ;; ($after-mod). A fast "asdf" also has another home row key physically
    ;; down at every press, and with $held alone it skipped the guard: D then
    ;; waited as a tap-hold, F was pressed and released under it, and the
    ;; result was "asF" (capture of 2026-11-22). When the previous key came
    ;; out as a letter this is a roll inside a word, so the guard applies
    ;; again. A key pressed while an earlier home row key is still undecided
    ;; waits in Kanata's queue and is looked at only once that key has become
    ;; a letter or a modifier, so "the key before" is always already decided.
    ((and (key-timing 1 less-than $key-timing-delay) (not (and $held $after-mod)))) $char break

    ;; NORMAL/SLOW TYPING: Use tap-hold behavior
    ;; - Tap (release within tap-timeout) → output character
    ;; - Hold (keep pressed for hold-timeout) → activate modifier
    ;; tap-hold-release-keys: besides the hold-timeout, the key also becomes
    ;; the modifier as soon as ANOTHER key is pressed and released while it
    ;; is down (so a quick D + Space + U is Shift+Home without waiting 200ms),
    ;; unless that other key is in tapkeys, which forces the character.
    () (tap-hold-release-keys $tap-timeout $hold-timeout $char $mod $tapkeys) break
  )
)

;; ================================================================================
;; SPECIAL TEMPLATE FOR 'A' KEY (WINDOWS/META KEY)
;; ================================================================================
;; The 'a' key gets special treatment because it maps to the Windows/Meta key,
;; which can trigger disruptive shortcuts (like Win+R opening the Run dialog).
;;
;; ENHANCED SAFETY FEATURES:
;; 1. Stricter fast-typing detection: Checks 4 keys (not 3) within 200ms
;; 2. Longer hold requirement: 300ms (not 200ms) to activate Windows key
;; 3. This prevents accidental Win+R when typing words like "are" quickly
;;
;; COMMON SCENARIO PREVENTED:
;; - Typing "are" quickly won't trigger Win+R
;; - You'd need to deliberately hold 'a' for 300ms to get Windows key
(deftemplate a-special (char mod tapkeys held)
  (switch 
    ;; ENHANCED FAST TYPING CHECK: 4 keys within 200ms
    ;; More conservative than standard keys to prevent accidental activation
    ;; Previous key less than 200ms ago -> plain character (see charmod).
    ((and (key-timing 1 less-than 200) (not (and $held $after-mod)))) $char break
    
    ;; LONGER HOLD REQUIREMENT: 300ms instead of 200ms
    ;; Gives more safety margin against accidental Windows key activation
    () (tap-hold-release-keys $tap-timeout 300 $char $mod $tapkeys) break
  )
)

;; ================================================================================
;; KEY ALIASES - HOME ROW MODIFIERS AND SPECIAL KEYS
;; ================================================================================
;; This section defines the actual key behaviors using the templates above.
;; Each alias creates a dual-function key that acts differently when tapped vs held.
;;
;; HOME ROW MODIFIER LAYOUT:
;; Left Hand:                    Right Hand:
;; a = Win/Meta (special)        j = Ctrl
;; s = Alt                       k = Shift  
;; d = Shift                     l = Alt
;; f = Ctrl                      ; = Win/Meta
;;
;; The 't!' syntax instantiates a template with specific parameters.
(defalias
  ;; CAPS LOCK → ESCAPE
  ;; Makes Caps Lock output Escape for easier Vim-style editing
  escctrl esc
  
  ;; ============ LEFT HAND HOME ROW MODIFIERS ============
  ;; 'A' KEY: Tap for 'a', Hold for Left Windows/Meta
  ;; Uses special template with stricter timing to prevent Win+R accidents
  ;; Extra tap keys l n m h p u: Win+L locks the PC, Win+N/M/H/P/U open
  ;; system panels, and "al", "an", "am", "ah", "ap", "au" start words.
  a (t! a-special a lmet (q w e r t g z x c v b l n m h p u)
     (or (input real s) (input real d) (input real f) (input real j) (input real k) (input real l) (input real ;)))
  
  ;; 'S' KEY: Tap for 's', Hold for Left Alt
  ;; Standard timing - useful for Alt+Tab, Alt+F4, etc.
  ;; Extra tap keys: the right-hand letters of common "s" bigrams (sh so si
  ;; su sy sp sk sl sn sm), so they never fire Alt+letter menu accelerators.
  s (t! charmod s lalt (q w e r t g z x c v b y u i o p h k l n m)
     (or (input real a) (input real d) (input real f) (input real j) (input real k) (input real l) (input real ;)))
  
  ;; 'D' KEY: Tap for 'd', Hold for Left Shift  
  ;; Standard timing - useful for capitalization and shift-clicking
  d (t! charmod d lsft $left-keys
     (or (input real a) (input real s) (input real f) (input real j) (input real k) (input real l) (input real ;)))
  
  ;; 'F' KEY: Tap for 'f', Hold for Left Control
  ;; Standard timing - useful for Ctrl+C, Ctrl+V, etc.
  f (t! charmod f lctl $left-keys
     (or (input real a) (input real s) (input real d) (input real j) (input real k) (input real l) (input real ;)))
  
  ;; ============ RIGHT HAND HOME ROW MODIFIERS ============
  ;; 'J' KEY: Tap for 'j', Hold for Right Control
  j (t! charmod j rctl $right-keys
     (or (input real a) (input real s) (input real d) (input real f) (input real k) (input real l) (input real ;)))
  
  ;; 'K' KEY: Tap for 'k', Hold for Right Shift
  k (t! charmod k rsft $right-keys
     (or (input real a) (input real s) (input real d) (input real f) (input real j) (input real l) (input real ;)))
  
  ;; 'L' KEY: Tap for 'l', Hold for Right Alt
  ;; Extra tap keys a e: "la" and "le" start words after a pause.
  l (t! charmod l ralt (y u i o p h n m , . / ' a e)
     (or (input real a) (input real s) (input real d) (input real f) (input real j) (input real k) (input real ;)))
  
  ;; ';' KEY: Tap for ';', Hold for Right Windows/Meta
  ; (t! charmod ; rmet $right-keys
     (or (input real a) (input real s) (input real d) (input real f) (input real j) (input real k) (input real l)))
  
  ;; 'I' KEY: No modification - passes through as normal 'i'
  i i
  
  ;; SPACE BAR: Tap for space, Hold to activate function layer
  ;; While held, activates the 'fn' layer for arrow keys and special functions
  ;; Uses very short tap-time (50ms) for responsive layer switching
  ;; tap-hold-release: also becomes the fn layer as soon as another key is
  ;; pressed AND released while Space is down, without waiting for hold-time.
  ;; That makes a quick Space+P a Backspace (and Ctrl+Space+P a Ctrl+Backspace);
  ;; with plain tap-hold a chord shorter than 200ms typed "space, p".
  ;; A roll from Space into the next letter (letter released after Space) is
  ;; still a space followed by the letter.
  ;; The key list: letters that do nothing special on the fn layer. Pressing one
  ;; of them while Space is still down means Space was just a space typed with
  ;; a lingering thumb, so it resolves as a tap at once. Without the list,
  ;; "i'll be" came out as "i'llb e": B was pressed and released under a
  ;; lingering Space, which made Space the fn layer and swallowed the space.
  ;; S, D and F are not in the list because they are Alt, Shift and Ctrl for
  ;; chords such as Space + D + U (Shift+Home).
  ;;
  ;; The switch in front: while a Win key of the home row (A or ;) is
  ;; physically down, Space is sent the moment it is pressed, with no
  ;; tap-or-hold wait. The tap-hold only sends Space when the thumb comes back
  ;; up, so Win+Alt+Space (; and L held, then Space) depended on letting go of
  ;; Space before the modifiers. In the capture of 2026-11-19 Win was released
  ;; 2 ms before Space and the shortcut did not form. The price: with A or ;
  ;; held first, Space cannot become the fn layer. For Win+arrow, press Space
  ;; first or use the board's layer 2 arrows.
  spfn (switch
    ((or (input real a) (input real ;))) spc break
    () (tap-hold-release-keys $tap-time $hold-time spc (layer-toggle fn) (w e r t g h z x c v b , .)) break)

  ;; LEFT THUMB OF THE W-CORNE: Tap for space, Hold for Left Shift
  ;; The W-CORNE's left space thumb sends F13, a key no other keyboard here
  ;; has, so this alias only ever applies to that board.
  ;; tap-hold-press is "hold-preferred", the same rule ZMK's &mt uses: the key
  ;; becomes Shift the moment any other key is pressed while it is down, so a
  ;; fast "?" or capital works even if the thumb is released before the letter.
  ;; Released alone within 200ms it is a space.
  ;; The first number is 0 on purpose: no "tap again and hold to repeat space",
  ;; so Space followed at once by Shift+letter gives a capital.
  lthumb (tap-hold-press 0 200 spc lsft)

  ;; SCREENSHOT KEY OF THE W-CORNE: Win+Shift+S (Snipping Tool overlay)
  ;; The board's two left thumbs pressed together send F14. The board used to
  ;; send Win+Shift+S itself, but S is a home row tap-hold key in this file,
  ;; so Kanata delayed the S until Win and Shift were already released and
  ;; the shortcut never formed. Sending the chord from here avoids that.
  snip M-S-s

  ;; The two C# lambda shortcuts from the ZMK Corne. On the W-CORNE they sit
  ;; on the right outer column of the board's layer 2 (outer right thumb held):
  ;; the top key sends F16, the bottom key sends F17. They used to be macros
  ;; stored on the board, which did not come out right, so the board now sends
  ;; one spare key and the text is typed from here.
  ;;   lam   =>
  ;;   lamx  (x => x.)  and then Left, so the caret sits before the ")"
  lam  (macro = S-.)
  lamx (macro S-9 x spc = S-. spc x . S-0 left)
)

;; ================================================================================
;; BASE LAYER - DEFAULT KEYBOARD LAYOUT
;; ================================================================================
;; This is the main layer active by default.
;; The @ symbol references aliases defined above.
;; Keys map to their physical positions from defsrc.
(deflayer base
  1    2    3    4    5    6    7    8    9    0
  q    w    e    r    t    y    n    [    ]
  @escctrl @a @s @d @f @i @j @k @l @; '
  u o p m /
  @spfn @lthumb @snip @lam @lamx
  h
  ;; ! @ # $ % ^ & for the W-CORNE. The board used to send Shift+digit itself.
  ;; Its middle thumb is Enter on tap and layer 1 on hold, decided on the
  ;; board; on a quick thumb+key press the board replays the key the moment it
  ;; is released, as four reports within a millisecond (Shift down, digit down,
  ;; digit up, Shift up), and the radio link only delivered the first and the
  ;; last: Shift went down and up and the digit never arrived (capture of
  ;; 2026-11-19). A single plain key survives that, so the board now sends one
  ;; F key per symbol and the Shift+digit is produced here.
  S-1  S-2  S-3  S-4  S-5  S-6  S-7
)

;; ================================================================================
;; FUNCTION LAYER - ACTIVATED BY HOLDING SPACE
;; ================================================================================
;; This layer is active while holding the space bar.
;; It provides arrow keys on the home row and other useful shortcuts.
;;
;; KEY MAPPINGS IN THIS LAYER:
;; Navigation (Vi-style):
;;   Space+i = Up arrow
;;   Space+j = Left arrow  
;;   Space+k = Down arrow
;;   Space+l = Right arrow
;;
;; Text Editing:
;;   Space+u = Home
;;   Space+o = End
;;   Space+p = Backspace
;;   Space+m = Delete
;;   Space+/ = Backslash (\)
;;
;; Navigation:
;;   Space+y = Page Up
;;   Space+h = Page Up (after Space has been held for a moment)
;;   Space+n = Page Down
;;
;; Special Keys:
;;   Space+q = Escape
;;   Space+a = Tab
;;   Space+; = Hyphen (-)
;;   Space+' = Equals (=)
;;
;; Function Keys:
;;   Space+1 through Space+0 = F1 through F10
;;   Space+[ = F11
;;   Space+] = F12
;;
;; The underscore (_) means "transparent" - the key passes through unchanged
(deflayer fn
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10
  esc  _    _    _    _    pgup pgdn f11  f12
  ;; s d f are plain Alt, Shift, Ctrl here, with no tap-hold timing: once Space
  ;; is held, Space+D+U is Shift+Home at any speed. On the base layer D would
  ;; first have to pass the "previous key less than 150ms ago" typing guard,
  ;; which turned a quick End, then Shift+Home into "d", Home.
  _    tab  lalt lsft lctl up   left down right - =
  home end bspc del \
  _ _ _ _ _
  ;; Space+H = PageUp, right above PageDown on N. H stays in spfn's tap list,
  ;; so this only fires once Space has been held past the hold time; a fast
  ;; " h" while typing is still a space and an h. Space+Y is PageUp as well.
  pgup
  _ _ _ _ _ _ _
)