;; Global configuration settings
;; process-unmapped-keys: allows keys not defined in layers to pass through
(defcfg
  process-unmapped-keys yes
;;  tap-next-release yes ;; Enable tap-next-release behavior
;;  log-layer-changes yes
)

;; Source keyboard layout definition
;; Defines which physical keys are mapped in this configuration
(defsrc
  1    2    3    4    5    6    7    8    9    0
  caps a s d f i j k l ;
  u o p m
  spc
)

;; Variables for timing configuration
(defvar
  tap-time 50
  hold-time 200
  key-timing-delay 150  ;; delay for key-timing check (reduced for faster typing)
  tap-timeout 150       ;; timeout for tap in tap-hold-release (reduced)
  hold-timeout 200      ;; timeout for hold activation (reduced for quicker response)
  ;; Eager tap - releases modifier immediately when another key is pressed
  eager-tap-timeout 120 ;; timeout for eager tap behavior
)

;; Template for advanced home row modifiers using switch and key-timing
;; This prevents accidental modifier activation while typing quickly
(deftemplate charmod (char mod)
  (switch 
    ((key-timing 3 less-than $key-timing-delay)) $char break
    () (tap-hold $tap-timeout $hold-timeout $char $mod) break
  )
)

;; Template for 'a' key with smart timing to prevent accidental Win+R
;; Uses a longer delay before modifier activation to allow normal typing
(deftemplate a-special (char mod)
  (switch 
    ;; If typing fast (4 keys in 200ms), output character
    ((key-timing 4 less-than 200)) $char break
    ;; Otherwise use tap-hold with longer hold time for modifier
    () (tap-hold $tap-timeout 300 $char $mod) break
  )
)

;; Key aliases definitions
;; Defines custom key behaviors including home row modifiers and layer toggles
(defalias
  escctrl esc  ;; Caps lock becomes Escape
  ;; Home row modifiers using the advanced template
  ;; Left hand: a=Meta/Win (using special timing to prevent accidental Win+R)
  a (t! a-special a lmet)
  ;; s=Alt, d=Shift, f=Ctrl (using standard template)
  s (t! charmod s lalt)
  d (t! charmod d lsft)
  f (t! charmod f lctl)
  ;; Right hand: j=Ctrl, k=Shift, l=Alt, ;=Meta/Win
  j (t! charmod j rctl)
  k (t! charmod k rsft)
  l (t! charmod l ralt)
  ; (t! charmod ; rmet)
  i i  ;; i key remains unchanged
  spfn (tap-hold $tap-time $hold-time spc (layer-toggle fn))  ;; Space: tap=space, hold=fn layer
)

;; Base layer definition
;; Maps physical keys to their behaviors (using @ for aliases)
(deflayer base
  1    2    3    4    5    6    7    8    9    0
  @escctrl @a @s @d @f @i @j @k @l @;
  u o p m
  @spfn
)

;; Function layer with i,j,k,l as arrow keys
(deflayer fn
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10
  _    _    _    _    _    up   left down right _
  home end bspc del
  _
)