;; Global configuration settings
;; process-unmapped-keys: allows keys not defined in layers to pass through
(defcfg
  process-unmapped-keys yes
;;  tap-next-release yes ;; Enable tap-next-release behavior
;;  log-layer-changes yes
)

;; Source keyboard layout definition
;; Defines which physical keys are mapped in this configuration
(defsrc
  1    2    3    4    5    6    7    8    9    0
  caps a s d f i j k l ;
  u o p m
  spc
)

;; Variables for timing configuration
(defvar
  tap-time 50
  hold-time 200
  key-timing-delay 250  ;; delay for key-timing check
  tap-timeout 200       ;; timeout for tap in tap-hold-release
  hold-timeout 500      ;; timeout for hold activation
)

;; Template for advanced home row modifiers using switch and key-timing
;; This prevents accidental modifier activation while typing quickly
(deftemplate charmod (char mod)
  (switch 
    ((key-timing 3 less-than $key-timing-delay)) $char break
    () (tap-hold-release-timeout $tap-timeout $hold-timeout $char $mod $char) break
  )
)

;; Key aliases definitions
;; Defines custom key behaviors including home row modifiers and layer toggles
(defalias
  escctrl esc  ;; Caps lock becomes Escape
  ;; Home row modifiers using the advanced template
  ;; Left hand: a=Meta/Win, s=Alt, d=Shift, f=Ctrl
  a (t! charmod a lmet)
  s (t! charmod s lalt)
  d (t! charmod d lsft)
  f (t! charmod f lctl)
  ;; Right hand: j=Ctrl, k=Shift, l=Alt, ;=Meta/Win
  j (t! charmod j rctl)
  k (t! charmod k rsft)
  l (t! charmod l ralt)
  ; (t! charmod ; rmet)
  i i  ;; i key remains unchanged
  spfn (tap-hold $tap-time $hold-time spc (layer-toggle fn))  ;; Space: tap=space, hold=fn layer
)

;; Base layer definition
;; Maps physical keys to their behaviors (using @ for aliases)
(deflayer base
  1    2    3    4    5    6    7    8    9    0
  @escctrl @a @s @d @f @i @j @k @l @;
  u o p m
  @spfn
)

;; Function layer with i,j,k,l as arrow keys
(deflayer fn
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10
  _    _    _    _    _    up   left down right _
  home end bspc del
  _
)